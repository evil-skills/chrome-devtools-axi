+/**
+ * Resolve the Claude Code `settings.json` paths this installer should write.
+ *
+ * Claude Code reads its config from `$CLAUDE_CONFIG_DIR` (default `~/.claude`).
+ * firstmate's glm crewmates launch the same Claude Code binary under a
+ * redirected config dir, exposed either as the standard `CLAUDE_CONFIG_DIR` or
+ * as firstmate's `FM_GLM_CLAUDE_CONFIG_DIR` (default `$HOME/.glm`). When a
+ * redirect is active we write BOTH the default and the redirected location so
+ * every Claude-compatible host the user may launch picks up the ambient hook;
+ * a mixed claude (`~/.claude`) + glm (`~/.glm`) fleet stays in sync. When no
+ * redirect is set, the result is the single default target and behavior is
+ * identical to before.
+ */
+export function resolveClaudeSettingsJsonTargets(home) {
+    const targets = [join(home, ".claude", "settings.json")];
+    const redirected = process.env.CLAUDE_CONFIG_DIR || process.env.FM_GLM_CLAUDE_CONFIG_DIR;
+    if (redirected) {
+        targets.push(join(redirected, "settings.json"));
+    }
+    // Dedupe in case the redirect resolves to the same path as the default.
+    return Array.from(new Set(targets));
+}
